<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".BirthdayDetailActivity">
    <LinearLayout
        style="@style/BirthdayToolbar">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            style="@style/BirthdayToolbarIcon"
            android:contentDescription="@string/back"
            app:srcCompat="@drawable/ic_back"
            app:tint="?attr/colorOnSurface" />
        <TextView
            android:id="@+id/tvTitle"
            style="@style/BirthdayToolbarTitle"
            android:text="@string/birthday_detail" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnEdit"
            style="@style/BirthdayToolbarIcon"
            android:contentDescription="@string/edit"
            app:srcCompat="@drawable/ic_edit"
            app:tint="?attr/colorOnSurface" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnArchive"
            style="@style/BirthdayToolbarIcon"
            android:contentDescription="@string/archive"
            app:srcCompat="@drawable/ic_archive"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            style="@style/BirthdayScreenContent">
            <com.google.android.material.card.MaterialCardView
                style="@style/BirthdaySurfaceCard"
                app:cardBackgroundColor="@color/home_hero"
                app:strokeWidth="0dp">
                <LinearLayout
                    style="@style/BirthdayCardContent">
                    <TextView
                        android:id="@+id/tvInitials"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                        android:textColor="@color/home_on_hero"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvDate"
                        style="@style/BirthdaySupportingText"
                        android:textColor="@color/home_hero_muted" />
                    <TextView
                        android:id="@+id/tvBirthdayStatus"
                        style="@style/BirthdaySupportingText"
                        android:textColor="@color/home_on_hero"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvAgeZodiac"
                        style="@style/BirthdaySupportingText"
                        android:textColor="@color/home_hero_muted"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/BirthdaySurfaceCard">
                <LinearLayout
                    style="@style/BirthdayCardContent">
                    <TextView
                        style="@style/BirthdaySectionHeading"
                        android:text="@string/next_reminder" />
                    <TextView
                        android:id="@+id/tvReminder"
                        style="@style/BirthdaySupportingText"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="?attr/colorOnSurface" />
                    <TextView
                        android:id="@+id/tvSnoozedReminder"
                        style="@style/BirthdaySupportingText"
                        android:textColor="?attr/colorPrimary"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tvReminderPlan"
                        style="@style/BirthdaySupportingText"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tvReminderStatus"
                        style="@style/BirthdaySupportingText"
                        android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReminderSettings"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/reminder_settings"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/BirthdaySurfaceCard">
                <LinearLayout
                    style="@style/BirthdayCardContent">
                    <TextView
                        style="@style/BirthdaySectionHeading"
                        android:text="@string/gift_notes" />
                    <TextView
                        android:id="@+id/tvNotes"
                        style="@style/BirthdaySupportingText" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCelebrate"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mark_celebrated"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMessage"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/compose_message"
                app:icon="@drawable/ic_message"
                app:iconGravity="textStart" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
